---
interface Props { href?: string; size?: "header" | "footer" | "loader"; }
const { href, size = "header" } = Astro.props;
const Tag = href ? "a" : "span";
---
<Tag class:list={["studioLogo", `studioLogo--${size}`]} href={href} aria-label={href ? "Design10 Entire Interior, home" : undefined}>
 <svg class="logoSymbol" viewBox="0 0 42 42" fill="none" aria-hidden="true"><path d="M2 2h28v28H2zM12 12h28v28H12z" stroke="currentColor" stroke-width="1.5" /><path d="M12 30V12h18" stroke="currentColor" stroke-width="3" /></svg>
 <span class="logoType"><span class="logoName">Design<span>10</span></span><span class="logoDescriptor">Entire Interior Pvt. Ltd.</span></span>
</Tag>
