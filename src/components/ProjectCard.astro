---
import IconArrow from "./IconArrow.astro";
import ProjectImage from "./ProjectImage.astro";
import { projectHref, type Project } from "../data/projects";
interface Props { project: Project; featured?: boolean; }
const { project, featured = false } = Astro.props;
---
<a class:list={["projectCard", { "projectCard--featured": featured, projectCardInterior: project.cardImage.kind === "interior" }]} data-project-id={project.id} href={projectHref(project.id)}>
	<div class="projectImage"><ProjectImage src={project.cardImage.src} alt={project.cardImage.alt} width={project.cardImage.width} height={project.cardImage.height} /><span class="projectOpen" aria-hidden="true"><IconArrow /></span></div>
	<div class="projectCaption"><h3>{project.name}</h3><span>{project.category}</span></div>
 <p class="projectSummary">{project.text}</p>
 <span class="projectStoryLink">Read the project story <IconArrow /></span>
</a>
<style>
 .projectCard { background: var(--surfaceRaised); border: 1px solid var(--borderSubtle); border-radius: var(--radiusCard); overflow: hidden; }
 .projectCaption { margin-inline: 20px; }
 .projectSummary { color: var(--textMuted); font-size: 15px; margin: 16px 20px 0; max-width: 58ch; }
 .projectStoryLink { display: flex; align-items: center; gap: 24px; margin: 20px 20px 18px; color: var(--goldDeep); font-size: 13px; min-height: 44px; }
</style>
