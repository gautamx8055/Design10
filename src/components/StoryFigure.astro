---
import type { StoryImage } from "../data/projectStories";
interface Props { image: StoryImage; eager?: boolean; }
const { image, eager = false } = Astro.props;
---
<figure class="storyFigure">
 <a href={image.src} target="_blank" rel="noopener" aria-label={`Open image: ${image.alt}`}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={eager ? "eager" : "lazy"} /></a>
 <figcaption>{image.caption}</figcaption>
</figure>
<style>
 .storyFigure { min-width: 0; }
 .storyFigure a { display: block; background: var(--surfaceSoft); }
 .storyFigure img { width: 100%; height: auto; }
 .storyFigure figcaption { margin-top: 14px; font-size: 12px; color: var(--textMuted); line-height: 1.5; }
</style>
