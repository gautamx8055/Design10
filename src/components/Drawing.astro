				<path class="line" pathLength="1" d="M68 180 V104" />
				<path class="line" pathLength="1" d="M148 180 V104" />
				<path class="line" pathLength="1" d="M252 180 V104" />
				<path class="line" pathLength="1" d="M332 180 V104" />
				<path class="line" pathLength="1" d="M68 104 H332" />
				<path class="line brass" pathLength="1" d="M52 90 H348" />
				<path class="line" pathLength="1" d="M68 76 H332" />
				<path class="line" pathLength="1" d="M92 168 V120 H136 V168" />
				<path class="line" pathLength="1" d="M114 168 V120" />
				<path class="line" pathLength="1" d="M176 180 V128 H224 V180" />
