				<path class="line" pathLength="1" d="M276 124 V84 H326 V124" />
				<path class="line" pathLength="1" d="M356 124 V84 H406 V124" />
				<path class="line" pathLength="1" d="M300 196 V170 H404 V196" />
				<path class="line" pathLength="1" d="M318 170 V158 H386 V170" />
