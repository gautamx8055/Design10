---
import Logo from "./Logo.astro";
import IconArrow from "./IconArrow.astro";
import { nav } from "../data/site";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<a class="skipLink" href="#content">Skip to content</a>
<header class="siteHeader">
 <div class="headerInner wrap">
  <Logo href="/" />
  <button class="menuToggle" type="button" aria-expanded="false" aria-controls="siteNav" data-menu-toggle><span data-menu-label>Menu</span><span class="menuIcon" aria-hidden="true"><i></i><i></i></span></button>
  <nav id="siteNav" class="siteNav" aria-label="Main navigation">
   {nav.map((item) => item.href === "/contact" ? <a class="button navContact" href={item.href} aria-current={currentPath === item.href ? "page" : undefined}><span class="buttonLabel">{item.label}</span><span class="buttonIcon"><IconArrow /></span></a> : <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>)}
  </nav>
 </div>
</header>
