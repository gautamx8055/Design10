---
import IconArrow from "./IconArrow.astro";
import { projects, projectHref } from "../data/projects";
import { projectStories } from "../data/projectStories";
const usePairLayout = (count: number) => count === 2;
---
<section class="portfolioShowcase sectionSpace" id="projectStories" aria-labelledby="portfolioShowcaseTitle">
 <div class="wrap">
  <div class="sectionHeading">
   <div><p class="sectionLabel">Selected work</p><h2 id="portfolioShowcaseTitle">Spaces with<br />a story.</h2></div>
   <div><p>Behind every space, a different idea. Explore the inspiration, planning and details that bring each project together.</p><a class="textLink" href="/portfolio">Explore the portfolio <IconArrow /></a></div>
  </div>
  <div class:list={["projectDeck", { projectDeckPair: usePairLayout(projects.length) }]} data-project-deck role="group" aria-label="Featured project stories">
   <div class="deckStage" id="projectDeckStage">
    {projects.map((project) => <a class="storyCard" href={projectHref(project.id)} data-project-card data-project-name={project.name}>
     <div class="storyCardTop"><span>{project.category}</span><IconArrow /></div>
     <div class:list={["storyCardImage", { storyCardImageInterior: project.cardImage.kind === "interior" }]}><img src={project.cardImage.src} alt={project.cardImage.alt} width={project.cardImage.width} height={project.cardImage.height} loading="lazy" /></div>
     <div class="storyCardCaption"><span>{projectStories[project.id].location || "Design10"}</span><h3>{project.name}</h3><p>Explore the project story <IconArrow /></p></div>
    </a>)}
   </div>
   <div class="deckControls" data-deck-controls hidden>
    <button class="deckArrow deckArrow--previous" type="button" aria-label="Show previous project" aria-controls="projectDeckStage" data-deck-previous><IconArrow /></button>
    <div class="deckProjectButtons" aria-label="Select a featured project">{projects.map((project, index) => <button type="button" data-deck-select={index} aria-pressed={index === 0 ? "true" : "false"} aria-controls="projectDeckStage">{project.name}</button>)}</div>
    <button class="deckArrow" type="button" aria-label="Show next project" aria-controls="projectDeckStage" data-deck-next><IconArrow /></button>
   </div>
   <p class="srOnly" role="status" aria-live="polite" data-deck-status></p>
  </div>
 </div>
</section>

<style>
 .portfolioShowcase { overflow: clip; background: var(--surfaceSoft); }
 .portfolioShowcase .sectionHeading { margin-bottom: 24px; }
 .portfolioShowcase h2 { max-width: 14ch; }
 .portfolioShowcase .sectionHeading > div + div { color: var(--textMuted); }
 .portfolioShowcase .textLink { color: var(--textPrimary); }
 .deckStage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; padding-block: 24px; max-width: 960px; margin-inline: auto; }
 .storyCard { min-width: 0; display: block; background: var(--surfaceDark); color: var(--surfaceRaised); border: 1px solid var(--borderOnDark); box-shadow: 0 16px 36px rgb(0 0 0 / .12); }
 .storyCard:focus-visible { outline: 3px solid var(--goldDeep); outline-offset: 7px; }
 .storyCardTop { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 15px 20px; border-bottom: 1px solid var(--borderOnDark); color: var(--goldLight); font-size: 11px; }
 .storyCardTop :global(.iconArrow) { width: 17px; height: 17px; }
 .storyCardImage { margin: 10px 10px 0; overflow: hidden; background: var(--surfaceDark); }
 .storyCardImage img { width: 100%; aspect-ratio: 4 / 5; object-fit: contain; }
 .storyCardImageInterior img { object-fit: cover; }
 .storyCardCaption { padding: 22px 24px 24px; }
 .storyCardCaption > span { font-size: 11px; color: var(--textOnDark); }
 .storyCardCaption h3 { font-size: clamp(23px, 2.4vw, 32px); margin-top: 6px; }
 .storyCardCaption > p { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--borderOnDark); color: var(--goldLight); font-size: 12px; }
 .deckControls { display: flex; justify-content: center; align-items: center; gap: 28px; margin-top: 16px; }
 .deckArrow { display: grid; place-items: center; width: 48px; height: 48px; flex: 0 0 auto; padding: 0; border: 1px solid var(--goldDeep); border-radius: 50%; background: transparent; color: var(--textPrimary); transition: background .2s, color .2s; }
 .deckArrow:hover { background: var(--surfaceDark); color: var(--goldLight); }
 .deckArrow--previous :global(.iconArrow) { transform: rotate(180deg); }
 .deckProjectButtons { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px; }
 .deckProjectButtons button { padding: 12px 0; min-height: 44px; background: transparent; border: 0; border-bottom: 1px solid transparent; font-size: 12px; color: var(--textMuted); transition: color .2s, border-color .2s; }
 .deckProjectButtons button:hover, .deckProjectButtons button[aria-pressed="true"] { color: var(--goldDeep); border-color: var(--goldDeep); }
 @media (min-width: 1001px) {
  .isEnhanced .deckStage { display: block; position: relative; height: clamp(640px, 56vw, 760px); padding: 0; max-width: none; }
  .isEnhanced .storyCard { --cardOffset: 0%; --cardLift: 80px; --cardRotation: 0deg; --cardScale: .6; position: absolute; left: 50%; bottom: 35px; width: clamp(280px, 29vw, 390px); opacity: 0; pointer-events: none; transform-origin: center 80%; transform: translateX(calc(-50% + var(--cardOffset))) translateY(var(--cardLift)) rotate(var(--cardRotation)) scale(var(--cardScale)); transition: transform .6s cubic-bezier(.22, 1, .36, 1), box-shadow .3s, opacity .3s; }
  .isEnhanced .storyCard:is([data-position="-2"], [data-position="-1"], [data-position="0"], [data-position="1"], [data-position="2"]) { opacity: 1; pointer-events: auto; }
  .isEnhanced .storyCard:focus-visible { transition-duration: .18s; }
  .isEnhanced .storyCard[data-position="0"] { --cardOffset: 0%; --cardLift: -10px; --cardRotation: 0deg; --cardScale: 1; z-index: 4; box-shadow: 0 24px 60px rgb(0 0 0 / .2); }
  .isEnhanced .storyCard[data-position="-1"] { --cardOffset: -72%; --cardLift: 32px; --cardRotation: -7deg; --cardScale: .87; z-index: 3; }
  .isEnhanced .storyCard[data-position="1"] { --cardOffset: 72%; --cardLift: 32px; --cardRotation: 7deg; --cardScale: .87; z-index: 2; }
  .isEnhanced .storyCard[data-position="-2"] { --cardOffset: -126%; --cardLift: 65px; --cardRotation: -11deg; --cardScale: .74; z-index: 1; }
  .isEnhanced .storyCard[data-position="2"] { --cardOffset: 126%; --cardLift: 65px; --cardRotation: 11deg; --cardScale: .74; z-index: 1; }
  .projectDeckPair.isEnhanced .storyCard[data-position="0"] { --cardOffset: -32%; --cardRotation: -2deg; }
  .projectDeckPair.isEnhanced .storyCard[data-position="-1"] { --cardOffset: 52%; --cardRotation: 5deg; --cardScale: .94; }
 }
 @media (max-width: 1000px) {
  .deckStage { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .deckControls { display: none; }
  .storyCardCaption h3 { font-size: 28px; }
 }
 @media (max-width: 600px) {
  .portfolioShowcase .sectionHeading { margin-bottom: 28px; }
  .deckStage { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 0; }
  .storyCardCaption { padding: 20px; }
  .storyCardCaption h3 { font-size: 27px; }
 }
</style>
