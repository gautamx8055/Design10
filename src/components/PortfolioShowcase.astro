---
import IconArrow from "./IconArrow.astro";
import ProjectImage from "./ProjectImage.astro";
import { projects, projectHref } from "../data/projects";
---
<section class="portfolioShowcase sectionSpace" id="projectStories" aria-labelledby="portfolioShowcaseTitle">
 <div class="wrap">
  <div class="sectionHeading">
   <div><p class="sectionLabel">Selected work</p><h2 id="portfolioShowcaseTitle">Spaces with<br />a story.</h2></div>
   <div><p>Behind every space, a different idea. Explore the inspiration, planning and details that bring each project together.</p><a class="textLink" href="/portfolio">Explore the portfolio <IconArrow /></a></div>
  </div>
  <div class="projectDeck" data-project-deck role="region" aria-label="Featured project stories">
   <div class="deckStage" id="projectDeckStage" data-deck-track tabindex="0" role="group" aria-label="Project cards">
    {projects.map((project) => <a class="storyCard" href={projectHref(project.id)} data-project-card data-project-name={project.name} aria-label={project.name + ": read the project story"}>
     <div class="storyCardTop"><span>{project.category}</span><IconArrow /></div>
     <div class="storyCardImage"><ProjectImage src={project.cardImage.src} alt={project.cardImage.alt} width={project.cardImage.width} height={project.cardImage.height} /></div>
     <div class="storyCardCaption"><h3>{project.name}</h3><span class="storyCardAction">Explore the project story <span><IconArrow /></span></span></div>
    </a>)}
   </div>
   <div class="deckControls" data-deck-controls hidden>
    <button class="deckArrow deckArrow--previous" type="button" aria-label="Show previous project" aria-controls="projectDeckStage" data-deck-previous><IconArrow /></button>
    <div class="deckSelector">
     <div class="deckProjectButtons" aria-label="Select a featured project">{projects.map((project, index) => <button type="button" data-deck-select={index} aria-label={"Show " + project.name} aria-pressed={index === 0 ? "true" : "false"} aria-controls="projectDeckStage"><span class="deckDot" aria-hidden="true"></span><span>{project.name}</span></button>)}</div>
     <p class="deckPosition" data-deck-counter aria-hidden="true">01 / {String(projects.length).padStart(2, "0")}</p>
    </div>
    <button class="deckArrow" type="button" aria-label="Show next project" aria-controls="projectDeckStage" data-deck-next><IconArrow /></button>
   </div>
   <p class="srOnly" role="status" aria-live="polite" data-deck-status></p>
  </div>
 </div>
</section>

<style>
 .portfolioShowcase { overflow: clip; background: var(--surfaceSoft); }
 .portfolioShowcase .sectionHeading { margin-bottom: 24px; }
 .portfolioShowcase h2 { max-width: 14ch; }
 .portfolioShowcase .sectionHeading > div + div { color: var(--textMuted); }
 .portfolioShowcase .textLink { color: var(--textPrimary); }
 .deckStage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--projectImageGap); max-width: 1000px; margin-inline: auto; padding-block: 24px; }
 .deckStage:focus-visible { outline: 2px solid var(--goldDeep); outline-offset: 6px; border-radius: var(--radiusCard); }
 .storyCard { min-width: 0; display: flex; flex-direction: column; background: var(--surfaceRaised); color: var(--textPrimary); border: 1px solid var(--borderSubtle); border-radius: var(--radiusCard); overflow: hidden; box-shadow: 0 16px 36px rgb(0 0 0 / .1); }
 .storyCard:hover { border-color: var(--gold); }
 .storyCard:focus-visible { outline: 3px solid var(--goldDeep); outline-offset: 6px; }
 .storyCardTop { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 15px 20px; border-bottom: 1px solid var(--borderSubtle); color: var(--goldDeep); font-size: 11px; }
 .storyCardTop :global(.iconArrow) { width: 17px; height: 17px; }
 .storyCardImage { min-width: 0; margin: 10px 10px 0; }
 .storyCardCaption { display: flex; flex: 1; flex-direction: column; padding: 22px 24px 24px; }
 .storyCardCaption h3 { font-size: clamp(23px, 2.5vw, 32px); line-height: 1.15; margin-bottom: 22px; text-wrap: balance; }
 .storyCardAction { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--borderSubtle); color: var(--goldDeep); font-size: 12px; }
 .storyCardAction > span { display: grid; place-items: center; width: 34px; height: 34px; flex: 0 0 auto; background: var(--surfaceDark); color: var(--goldLight); border-radius: 50%; }
 .storyCardAction :global(.iconArrow) { width: 17px; height: 17px; transition: transform .2s; }
 .storyCard:hover .storyCardAction :global(.iconArrow) { transform: rotate(-35deg); }
 .deckControls { display: grid; grid-template-columns: 48px minmax(0, 1fr) 48px; align-items: start; gap: 24px; margin-top: 20px; }
 .deckArrow { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 1px solid var(--goldDeep); border-radius: 50%; background: var(--surfaceRaised); color: var(--textPrimary); transition: background .2s, color .2s; }
 .deckArrow:hover { background: var(--surfaceDark); color: var(--goldLight); }
 .deckArrow--previous :global(.iconArrow) { transform: rotate(180deg); }
 .deckSelector { display: flex; flex-direction: column; align-items: center; gap: 14px; }
 .deckProjectButtons { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
 .deckProjectButtons button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 10px 16px; border: 1px solid var(--borderSubtle); border-radius: 999px; background: var(--surfaceRaised); font-size: 12px; color: var(--textMuted); transition: background .2s, color .2s, border-color .2s; }
 .deckDot { width: 6px; height: 6px; flex: 0 0 auto; background: currentColor; border-radius: 50%; }
 .deckProjectButtons button:hover { border-color: var(--goldDeep); color: var(--goldDeep); }
 .deckProjectButtons button[aria-pressed="true"] { background: var(--surfaceDark); border-color: var(--surfaceDark); color: var(--goldLight); }
 .deckPosition { font-size: 12px; font-variant-numeric: tabular-nums; color: var(--goldDeep); }
 @media (min-width: 1001px) {
  .isEnhanced .deckStage { position: relative; display: block; height: clamp(520px, 45vw, 640px); max-width: none; padding: 0; }
  .isEnhanced .storyCard { --cardOffset: 0%; --cardLift: 70px; --cardRotation: 0deg; --cardScale: .7; position: absolute; left: 50%; bottom: 32px; width: clamp(280px, 30vw, 420px); transform-origin: center 80%; transform: translateX(calc(-50% + var(--cardOffset))) translateY(var(--cardLift)) rotate(var(--cardRotation)) scale(var(--cardScale)); opacity: 0; pointer-events: none; transition: transform .6s cubic-bezier(.22, 1, .36, 1), box-shadow .3s, border-color .2s, opacity .3s; }
  .isEnhanced .storyCard:is([data-position="-2"], [data-position="-1"], [data-position="0"], [data-position="1"], [data-position="2"]) { opacity: 1; pointer-events: auto; }
  .isEnhanced .storyCard[data-position="0"] { --cardOffset: 0%; --cardLift: -10px; --cardRotation: 0deg; --cardScale: 1; z-index: 4; border-color: var(--gold); box-shadow: 0 24px 60px rgb(0 0 0 / .16); }
  .isEnhanced .storyCard[data-position="-1"] { --cardOffset: -72%; --cardLift: 30px; --cardRotation: -7deg; --cardScale: .87; z-index: 3; }
  .isEnhanced .storyCard[data-position="1"] { --cardOffset: 72%; --cardLift: 30px; --cardRotation: 7deg; --cardScale: .87; z-index: 2; }
  .isEnhanced .storyCard[data-position="-2"] { --cardOffset: -126%; --cardLift: 62px; --cardRotation: -11deg; --cardScale: .74; z-index: 1; }
  .isEnhanced .storyCard[data-position="2"] { --cardOffset: 126%; --cardLift: 62px; --cardRotation: 11deg; --cardScale: .74; z-index: 1; }
  .isEnhanced .storyCard:focus-visible { transition-duration: .18s; }
 }
 @media (max-width: 1000px) {
  .deckControls { display: none; }
  .storyCardCaption h3 { font-size: 28px; }
 }
 @media (max-width: 600px) {
  .portfolioShowcase .sectionHeading { margin-bottom: 28px; }
  .deckStage { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 0; }
  .storyCardCaption { padding: 20px; }
  .storyCardCaption h3 { font-size: 27px; }
 }
</style>
