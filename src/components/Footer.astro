---
import Logo from "./Logo.astro";
import { nav, studio } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const rooms = [
	{ href: "/work/the-necklace-room", label: "Jewelry showrooms" },
	{ href: "/work/house-with-a-court", label: "Residences" },
	{ href: "/work/the-long-table", label: "Banquet halls" },
	{ href: "/services", label: "How a commission proceeds" },
];
---

<footer class="site-footer">
	<div class="footer-sheet">
		<div class="footer-mast">
			<div class="footer-intro">
				<Logo href="/" size="footer" />
				<p>
					Complete interiors for jewelry showrooms, homes, and banquet halls.
					{" "}
					{studio.principal} has led the work since {studio.since}, from the plan to the last surface.
				</p>
			</div>
			<svg class="footer-mark" viewBox="0 0 220 120" aria-hidden="true">
				<path d="M12 96 H208" />
				<path d="M28 96 V48 H192 V96" />
				<path class="brass" d="M20 48 H200" />
				<path d="M28 36 H192" />
				<path d="M48 84 V58 H84 V84" />
				<path d="M96 96 V62 H124 V96" />
				<path d="M136 84 V58 H172 V84" />
			</svg>
			<a class="button" href="/contact">Start a conversation</a>
		</div>

		<div class="footer-columns">
			<nav class="footer-block" aria-label="Footer">
				<h2>Visit</h2>
				<ul>
					{
						nav.map((item) => {
							const active = current === item.href || current.startsWith(`${item.href}/`);
							return (
								<li>
									<a href={item.href} aria-current={active ? "page" : undefined}>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
			<div class="footer-block">
				<h2>Rooms</h2>
				<ul>
					{
						rooms.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="footer-block">
				<h2>Studio</h2>
				<ul>
					<li><a href={`mailto:${studio.email}`}>{studio.email}</a></li>
					<li><a href={studio.phoneHref}>{studio.phone}</a></li>
					<li>{studio.city}</li>
					<li>{studio.principal}, architect</li>
				</ul>
			</div>
		</div>

		<div class="footer-base">
			<p>{studio.name}</p>
			<p>Since {studio.since}</p>
			<p class="footer-note">
				Films, project names, and quotations are samples until the studio’s own material is added.
			</p>
		</div>
	</div>
</footer>
