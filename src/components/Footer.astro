---
import Logo from "./Logo.astro";
import ButtonLink from "./ButtonLink.astro";
import { nav, studio } from "../data/site";
---
<footer class="siteFooter">
 <div class="wrap">
  <div class="footerInvitation"><div><p>{studio.disciplines}</p><h2>Start a conversation.</h2></div><ButtonLink href="/contact">Contact the studio</ButtonLink></div>
  <div class="footerGrid">
   <div class="footerIdentity"><Logo href="/" size="footer" /><p>{studio.name} is the practice of {studio.principal}, {studio.founderTitle}. Architecture, interior, and design since {studio.since}.</p></div>
   <nav aria-label="Footer">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
   <div class="footerPractice"><p>{studio.principal}</p><span>{studio.founderTitle}</span><p>Practising across India<br />Since 6 October 1996</p></div>
  </div>
  <div class="footerBase"><span>© {new Date().getFullYear()} {studio.name}</span><span>Architecture | Interior | Design</span><a href="#top">Back to top <span aria-hidden="true">↑</span></a></div>
 </div>
</footer>
