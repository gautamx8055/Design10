---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import SiteEffects from "../components/SiteEffects.astro";
import "../styles/global.css";
interface Props { title: string; description: string; image?: string; projectId?: string; }
const { title, description, image = "/images/projects/giriZewarMahal/giriZevarMahalInterior.webp", projectId } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isPortfolioPage = Astro.url.pathname === "/portfolio" || Astro.url.pathname.startsWith("/portfolio/");
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} /><meta name="theme-color" content="#111111" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={imageUrl} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;450;500;550;600;650;700&family=DM+Sans:wght@400;450;500;550;600&display=swap" rel="stylesheet" />
  <script is:inline>
   document.documentElement.classList.add("hasJs");
   try { if (sessionStorage.getItem("design10Loaded") || matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("isLoaded"); } catch { document.documentElement.classList.add("isLoaded"); }
   // ClientRouter replaces <html> attributes and deduplicates this script.
   // Restore the interactive layout before the next page is painted.
   document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.add("hasJs", "isLoaded");
   });
   window.setTimeout(() => document.documentElement.classList.add("isLoaded"), 1500);
  </script>
  <ClientRouter /><slot name="head" />
 </head>
 <body id="top" data-project-id={projectId} class:list={{ homePage: Astro.url.pathname === "/", portfolioPage: isPortfolioPage }}><Loader /><Header /><main id="content"><slot /></main><Footer /><SiteEffects /></body>
</html>
