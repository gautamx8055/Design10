---
import Drawing from "../components/Drawing.astro";
import VideoFrame from "../components/VideoFrame.astro";
import Base from "../layouts/Base.astro";
import { studio } from "../data/site";
---

<Base
	title="About Design10 Entire Interior"
	description="About Design10 Entire Interior Pvt. Ltd. and its founder, Shahnawaz Ahmed, who began the practice on 6 October 1996."
	image="/posters/residence.jpg"
>
	<div class="wrap page">
		<header class="page-title">
			<h1>About</h1>
			<p>
				{studio.name}. {studio.disciplines}. Founded by {studio.principal},
				{studio.founderTitle}.
			</p>
		</header>

		<div class="split">
			<figure class="portrait">
				<div class="portrait-frame" role="img" aria-label="Portrait of Shahnawaz Ahmed, to be placed here">
					<span>SA</span>
				</div>
				<figcaption>{studio.principal}</figcaption>
			</figure>
			<div class="stack measure">
				<p>
					On {studio.founded}, Mr. Shahnawaz Ahmed began his professional journey
					in architecture and design. What started as his first project has grown
					into a remarkable journey spanning three decades of creativity,
					dedication and architectural excellence.
				</p>
				<p>
					With experience across India, he has worked on a diverse range of
					residential and commercial projects, transforming ideas into thoughtfully
					designed spaces that balance space, aesthetic, functionality and the
					unique identity of every client.
				</p>
				<p>
					The portfolio includes 1000+ complete projects, reflecting a deep
					understanding of design, space planning, detailing and client requirements.
				</p>
			</div>
		</div>

		<section class="section measure">
			<h2>The practice</h2>
			<p>
				Design10 continues to deliver distinctive design solutions for every client,
				every space, every vision. The work reaches across India, from luxury
				residences to jewellery showrooms and other commercial spaces.
			</p>
			<blockquote class="pull">
				<p>{studio.quote}</p>
				<footer>{studio.principal}</footer>
			</blockquote>
			<p class="actions">
				<a class="button" href="/journey">Our Journey</a>
				<a href="/contact">Contact the studio</a>
			</p>
		</section>

		<div class="drawing-row section">
			<Drawing kind="stair" label="Section through a stair" />
			<Drawing kind="pavilion" label="A commercial front" />
		</div>
		<VideoFrame film="residence" />
	</div>
</Base>
