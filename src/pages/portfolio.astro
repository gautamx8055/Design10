---
import Base from "../layouts/Base.astro";
import IconArrow from "../components/IconArrow.astro";
import UrmilStudy from "../components/UrmilStudy.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { projectStories } from "../data/projectStories";
import { studioCopy } from "../data/content";
import { clients, multiLocationClients } from "../data/clients";
const directory = [...multiLocationClients.map((client) => ({ name: client.name, location: client.locations.join(", ") })), ...clients];
---
<Base title="Portfolio and clients | Design10 Entire Interior" description="Architecture and jewellery showroom projects by Design10 Entire Interior Pvt. Ltd., including Urmil Jewellers, Ganga Jewellers, Giri Zevar Mahal and Umeed Harpal Gaoshala.">
 <header class="pageIntro wrap"><p class="sectionLabel">1000+ completed projects</p><div class="pageIntroGrid"><h1>{studioCopy.portfolioTitle}</h1><div><p>Architectural concepts and jewellery houses across Delhi, Haryana, Punjab, Uttarakhand, and Uttar Pradesh. Houses with more than one showroom are grouped below.</p><a class="textLink" href="#directory">See the client list <IconArrow direction="down" /></a></div></div></header>
 <div class="wrap"><nav class="projectNavigation" aria-label="Project index">{projects.map((project) => <a href={`#${project.id}`}>{project.name}<IconArrow direction="down" /></a>)}</nav>
 <div class="portfolioCardGrid">{projects.map((project) => <article id={project.id}><ProjectCard project={project} /><p class="projectArchiveNote">{projectStories[project.id].representation}</p></article>)}</div>
 <UrmilStudy />
 <section class="clientSection sectionSpace" id="groups"><div class="sectionHeading"><h2>Clients with multiple locations</h2><p>{studioCopy.clients}</p></div><div class="clientGroups">{multiLocationClients.map((client) => <article id={client.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}><h3>{client.name}</h3><p>{client.locations.join(", ")}</p></article>)}</div><section class="clientDirectory" id="directory"><h2>All clients</h2><ol class="clientDirectoryList">{directory.map((client) => <li><strong>{client.name}</strong><span>{client.location}</span></li>)}</ol></section></section>
 </div>
</Base>
<style>
 .portfolioCardGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px var(--projectImageGap); padding-block: 24px 64px; }
 .portfolioCardGrid article { min-width: 0; }
 .projectArchiveNote { color: var(--textMuted); font-size: 11px; margin-top: 8px; }
 @media (max-width: 800px) { .portfolioCardGrid { row-gap: 44px; } }
 @media (max-width: 600px) { .portfolioCardGrid { grid-template-columns: minmax(0, 1fr); gap: 44px; padding-bottom: 30px; } }
</style>
