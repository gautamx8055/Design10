---
import Drawing from "../components/Drawing.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { expertise } from "../data/content";
---

<Base
	title="Services | Design10 Entire Interior"
	description="Residential, jewellery showroom, commercial, and architectural design by Design10 Entire Interior Pvt. Ltd., practising across India."
	image="/posters/jewelry.jpg"
>
	<PageHero variant="services" />
	<div class="wrap page">

		<div class="section">
			{
				expertise.map((item) => (
					<article class="service-row section" id={item.id}>
						<Drawing kind={item.kind} label={item.label} />
						<div>
							<h2>{item.title}</h2>
							<p class="measure">{item.text}</p>
						</div>
					</article>
				))
			}
		</div>

		<p class="actions">
			<a class="button" href="/contact">Start a conversation</a>
			<a href="/portfolio">See the clients</a>
		</p>
	</div>
</Base>
