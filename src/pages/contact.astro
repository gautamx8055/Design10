---
import Drawing from "../components/Drawing.astro";
import PageHero from "../components/PageHero.astro";
import Base from "../layouts/Base.astro";
import { formEndpoint, studio } from "../data/site";
---

<Base
	title="Contact Design10 Entire Interior"
	description="Write to Design10 Entire Interior Pvt. Ltd. about a residence, a jewellery showroom, a commercial interior, or an architectural project."
	image="/posters/residence.jpg"
>
	<PageHero variant="contact" />
	<div class="wrap page">
		<div class="contact-grid section">
			<form
				class="contact-form"
				action={formEndpoint}
				method="POST"
				data-contact-form
			>
				<input type="hidden" name="_subject" value="New enquiry for Design10 Entire Interior" />
				<p class="hp" aria-hidden="true">
					<label for="company">Company</label>
					<input id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
				</p>
				<div class="field">
					<label for="name">Name</label>
					<input id="name" name="name" type="text" autocomplete="name" required />
					<p class="field-error" data-error-for="name"></p>
				</div>
				<div class="field">
					<label for="email">Email</label>
					<input id="email" name="email" type="email" autocomplete="email" required />
					<p class="field-error" data-error-for="email"></p>
				</div>
				<div class="field">
					<label for="phone">Phone</label>
					<input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
					<p class="field-error" data-error-for="phone"></p>
				</div>
				<div class="field">
					<label for="project">Room you need</label>
					<select id="project" name="project" required>
						<option value="">Choose one</option>
						<option>Residential</option>
						<option>Jewellery showroom</option>
						<option>Commercial</option>
						<option>Architectural</option>
					</select>
					<p class="field-error" data-error-for="project"></p>
				</div>
				<div class="field">
					<label for="message">The day the room has to hold</label>
					<textarea id="message" name="message" required minlength="12"></textarea>
					<p class="field-error" data-error-for="message"></p>
				</div>
				<button class="button" type="submit">Send message</button>
				<p class="status" data-status role="status"></p>
			</form>
			<aside class="stack">
				<Drawing kind="court" label="Plan of a courtyard house" />
				<Drawing kind="stair" label="Section through a stair" />
				<p>
					<a href={`mailto:${studio.email}`}>{studio.email}</a><br />
					<a href={studio.phoneHref}>{studio.phone}</a><br />
					{studio.city}
				</p>
				<p class="sample">
					The form sends through Formspree once the studio’s form address is
					connected.
				</p>
			</aside>
		</div>
	</div>
</Base>
