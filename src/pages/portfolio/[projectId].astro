---
import Base from "../../layouts/Base.astro";
import StoryFigure from "../../components/StoryFigure.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import ProjectFilm from "../../components/ProjectFilm.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import IconArrow from "../../components/IconArrow.astro";
import { projects, projectHref, type Project } from "../../data/projects";
import { projectStories, type ProjectStory } from "../../data/projectStories";

export function getStaticPaths() {
 return projects.map((project, index) => ({ params: { projectId: project.id }, props: { project, story: projectStories[project.id], nextProject: projects[(index + 1) % projects.length] } }));
}
interface Props { project: Project; story: ProjectStory; nextProject: Project; }
const { project, story, nextProject } = Astro.props;
const enquiryType = story.enquiryType ?? "Jewellery Showroom";
const imageChapters = story.chapters.filter((chapter) => chapter.image);
---
<Base title={`${project.name} | Design10 Project`} description={project.text} image={project.image} projectId={project.id}>
 <header class="storyHeader wrap">
  <nav class="storyBreadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/portfolio">Portfolio</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav>
  <div class="storyOpening"><div class="storyHeading"><p class="sectionLabel">{story.location ? `${story.location} / ${project.category}` : project.category}</p><h1>{project.name}</h1><p class="storyLead">{story.lead}</p></div><figure class="storyCover"><ProjectImage src={project.image} alt={project.alt} width={project.width} height={project.height} loading="eager" priority /><figcaption>{project.text}</figcaption></figure></div>
  <dl class="storyFacts"><div><dt>Client</dt><dd>{project.name}</dd></div><div><dt>Project focus</dt><dd>{project.category}</dd></div><div><dt>Project archive</dt><dd>{story.representation}</dd></div></dl>
  <nav class="storyChapterNav" aria-label="Explore this project">{story.chapters.map((chapter) => <a href={`#${chapter.id}`}>{chapter.navLabel ?? ({ startingPoint: "The beginning", inspiration: "Inspiration", spacePlanning: "Space planning", materialsAndLight: "Materials & light", privateConsultation: "Consultation", displayDetail: "Display detail" } as Record<string, string>)[chapter.id]}</a>)}{story.evolution && <a href="#conceptAndBuilt">Concept & built</a>}{story.film && <a href="#projectFilm">The walkthrough</a>}<a href="#projectOutcome">The outcome</a></nav>
 </header>
 <div class="storyChapters wrap">
  {story.chapters.map((chapter) => <section id={chapter.id} class:list={["storyChapter", { "storyChapter--withImage": Boolean(chapter.image), "storyChapter--imageLeft": Boolean(chapter.image) && imageChapters.indexOf(chapter) % 2 === 0 }]}>
   <div class="storyChapterTitle"><h2>{chapter.title}</h2>{chapter.image && <div class="storyChapterText">{chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>}</div>
   {chapter.image ? <StoryFigure image={chapter.image} /> : <div class="storyChapterText">{chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{chapter.id === "materialsAndLight" && <ul class="storyMaterials">{story.materials.map((material) => <li>{material}</li>)}</ul>}</div>}
  </section>)}
 </div>
 {story.evolution && <section class="storyEvolution sectionSpace" id="conceptAndBuilt"><div class="wrap"><div class="sectionHeading"><div><p class="sectionLabel">From the archive</p><h2>From drawing<br />to the street.</h2></div><p>The elevation concept and the built exterior, shown side by side. Two views of the project's architectural identity.</p></div><div class="storyEvolutionGrid"><StoryFigure image={story.evolution.concept} /><StoryFigure image={story.evolution.built} /></div></div></section>}
 {story.film && <section class="storyWalkthrough wrap sectionSpace" id="projectFilm" aria-labelledby="walkthroughTitle"><div class="sectionHeading"><div><p class="sectionLabel">A closer look</p><h2 id="walkthroughTitle">Walk through<br />the idea.</h2></div><p>Explore the interior through the project's design walkthrough.</p></div><ProjectFilm film={story.film} /></section>}
 <section class="storyOutcome sectionSpace" id="projectOutcome"><div class="wrap storyOutcomeGrid"><div><p class="sectionLabel">The outcome</p><h2>{story.outcome.title}</h2></div><div><p>{story.outcome.text}</p><ul>{story.outcome.details.map((detail) => <li>{detail}</li>)}</ul><ButtonLink href={`/contact?project=${encodeURIComponent(enquiryType)}`}>Discuss your space</ButtonLink></div></div></section>
 <aside class="nextProject wrap sectionSpace" aria-label="Continue exploring"><a class="nextProjectLink" href={projectHref(nextProject.id)}><div><p class="sectionLabel">Next project</p><h2>{nextProject.name}</h2><span>Explore the story <IconArrow /></span></div><ProjectImage src={nextProject.cardImage.src} alt={nextProject.cardImage.alt} width={nextProject.cardImage.width} height={nextProject.cardImage.height} /></a><a class="textLink" href="/portfolio">Back to the portfolio <IconArrow /></a></aside>
</Base>

<style>
 .storyHeader { padding-top: 28px; }
 .storyBreadcrumb { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--textMuted); }
 .storyBreadcrumb a { min-height: 44px; display: inline-flex; align-items: center; }
 .storyBreadcrumb > span { display: inline-flex; align-items: center; }
 .storyBreadcrumb a:hover { color: var(--goldDeep); }
 .storyOpening { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--projectImageGap); align-items: center; margin-block: 54px 40px; }
 .storyHeading { min-width: 0; }
 .storyHeading .sectionLabel { color: var(--goldDeep); }
 .storyHeading h1 { font-size: clamp(42px, 5vw, 72px); max-width: 12ch; line-height: 1.05; text-wrap: balance; }
 .storyLead { font-size: 17px; color: var(--textMuted); max-width: 48ch; margin-top: 28px; }
 .storyFacts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding-block: 24px; border-top: 1px solid var(--borderSubtle); }
 .storyFacts dt { font-size: 11px; color: var(--textMuted); }
 .storyFacts dd { font-size: 14px; margin-top: 7px; }
 .storyCover figcaption { padding-block: 16px; font-size: 12px; line-height: 1.6; color: var(--textMuted); background: var(--surfaceBase); }
 .storyChapterNav { display: flex; flex-wrap: wrap; gap: 8px 28px; padding-block: 22px 26px; border-bottom: 1px solid var(--borderSubtle); }
 .storyChapterNav a { min-height: 44px; display: inline-flex; align-items: center; font-size: 13px; border-bottom: 1px solid var(--gold); }
 .storyChapterNav a:hover { color: var(--goldDeep); }
 .storyChapter { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--projectImageGap); padding-block: clamp(56px, 7vw, 104px); border-bottom: 1px solid var(--borderSubtle); }
 .storyChapter:last-child { border-bottom: 0; }
 .storyChapter h2 { font-size: clamp(32px, 3.3vw, 48px); max-width: 17ch; line-height: 1.15; text-wrap: balance; }
 .storyChapter--withImage { align-items: center; grid-template-areas: "content image"; }
 .storyChapter--withImage .storyChapterTitle { grid-area: content; }
 .storyChapter--withImage > :global(.storyFigure) { grid-area: image; }
 .storyChapter--imageLeft { grid-template-areas: "image content"; }
 .storyChapter--withImage .storyChapterText { margin-top: 28px; }
 .storyChapterText p { max-width: 58ch; color: var(--textMuted); line-height: 1.85; }
 .storyChapterText p + p { margin-top: 22px; }
 .storyMaterials { display: flex; flex-wrap: wrap; gap: 10px 24px; list-style: none; padding: 24px 0 0; margin: 24px 0 0; border-top: 1px solid var(--borderSubtle); font-size: 13px; color: var(--goldDeep); }
 .storyEvolution { background: var(--surfaceSoft); }
 .storyEvolutionGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--projectImageGap); }
 .storyOutcome { background: var(--surfaceDark); color: var(--surfaceRaised); }
 .storyOutcomeGrid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 10%; }
 .storyOutcome .sectionLabel { color: var(--goldLight); }
 .storyOutcome h2 { max-width: 15ch; font-size: clamp(36px, 4vw, 58px); line-height: 1.12; text-wrap: balance; }
 .storyOutcomeGrid > div + div > p { color: var(--textOnDark); line-height: 1.85; }
 .storyOutcome ul { list-style: none; padding: 0; margin: 30px 0; }
 .storyOutcome li { padding-block: 14px; border-top: 1px solid var(--borderOnDark); font-size: 14px; color: var(--goldLight); }
 .storyOutcome :global(.button) { --buttonSurface: var(--gold); --buttonHoverSurface: var(--goldLight); --buttonText: var(--surfaceDark); --buttonBorder: var(--gold); --buttonIconSurface: var(--surfaceDark); --buttonIconText: var(--goldLight); }
 .storyOutcome :global(:focus-visible) { outline-color: var(--goldLight); }
 .nextProjectLink { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--projectImageGap); align-items: center; padding-bottom: 40px; border-bottom: 1px solid var(--borderSubtle); }
 .nextProjectLink h2 { font-size: clamp(36px, 4.5vw, 64px); }
 .nextProjectLink span { display: flex; align-items: center; gap: 24px; color: var(--goldDeep); margin-top: 24px; font-size: 14px; }
 .nextProject > .textLink { margin-top: 30px; }
 @media (max-width: 900px) {
  .storyOutcomeGrid { gap: 6%; }
  .storyLead, .storyChapterText p { font-size: 15px; }
  .storyChapter h2 { font-size: 34px; }
 }
 @media (max-width: 600px) {
  .storyHeader { padding-top: 14px; }
  .storyBreadcrumb { gap: 8px; font-size: 11px; }
  .storyOpening { grid-template-columns: minmax(0, 1fr); gap: var(--projectImageGap); margin-block: 32px; }
  .storyHeading h1 { font-size: clamp(42px, 12vw, 64px); }
  .storyHeading .sectionLabel { margin-bottom: 18px; }
  .storyFacts { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .storyFacts > div { display: flex; justify-content: space-between; gap: 20px; }
  .storyFacts dd { margin: 0; text-align: right; font-size: 12px; }
  .storyCover figcaption { font-size: 11px; }
  .storyChapterNav { gap: 4px 22px; padding-block: 10px 24px; }
  .storyChapterNav a { font-size: 12px; }
  .storyChapter { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 48px; }
  .storyChapter--withImage { grid-template-areas: "content" "image"; }
  .storyChapter h2 { max-width: 20ch; font-size: 32px; }
  .storyChapter--withImage .storyChapterText { margin-top: 24px; }
  .storyEvolutionGrid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .storyOutcomeGrid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .storyOutcome h2 { font-size: 36px; }
  .nextProjectLink { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-bottom: 28px; }
  .nextProjectLink h2 { font-size: 36px; }
 }
</style>
